# Required AI key used by the generator
LLM_API_KEY=replace_me

# Optional image providers
FREEPIK_API_KEY=
FREEPIK_API_BASE=https://api.freepik.com/v1
FREEPIK_LANG=en-US
FREEPIK_IMAGE_SIZE=large
USE_AI_IMAGES=1
OPENAI_IMAGE_MODEL=gpt-image-1
OPENAI_IMAGE_SIZE=1024x1024

# OpenAI TTS settings
OPENAI_TTS_MODEL=tts-1
OPENAI_TTS_VOICE=alloy
OPENAI_TTS_NORMAL_SPEED=1.0
OPENAI_TTS_SLOW_SPEED=0.75

# H5P receiver/editor integration
H5P_IMPORT_ENDPOINT=
H5P_IMPORT_TOKEN=
H5P_EDITOR_URL=

# Optional Wikimedia identification
H5P_IMG_USER_AGENT=H5PActivityGenerator/1.0
